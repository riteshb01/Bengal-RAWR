# Bengal RAWR — environment variables
# Copy to .env and fill in values. Never commit .env to git.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave blank to use SQLite in development)
# DB_ENGINE=postgresql
# DB_NAME=bengal_rawr
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# CORS (comma-separated, production frontend origins only)
# CORS_ALLOWED_ORIGINS_EXTRA=https://yourdomain.com

# Embedding model (default is fine for local/small deployments)
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
